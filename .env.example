# Copy to .env to override defaults (SPEC section 2). Never commit .env.
FINBOT_MODEL=qwen3:8b
# Output caps: Ollama (older name; FINBOT_MAX_OUTPUT_TOKENS_OLLAMA wins) and the vLLM/OpenAI backend
FINBOT_MAX_OUTPUT_TOKENS=700
FINBOT_MAX_OUTPUT_TOKENS_OPENAI=1500
FINBOT_BACKEND=ollama
FINBOT_BASE_URL=http://localhost:11434
FINBOT_THINKING=off
FINBOT_NUM_CTX=16384
FINBOT_TEMPERATURE=0.0
FINBOT_EMBED_MODEL=bge-m3
FINBOT_EMBED_URL=http://localhost:11434
FINBOT_MIN_DENSE_SCORE=0.50
